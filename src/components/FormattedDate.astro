---
import { getFormattedDate } from "@/utils/date";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"time"> & {
	date: Date | string;
	dateTimeOptions?: Intl.DateTimeFormatOptions;
	format?: "full" | "monthYear";
};

const { date, dateTimeOptions, format = "full", ...attrs } = Astro.props;

// Ensure date is a Date object
const dateObj = date instanceof Date ? date : new Date(date);

let postDate: string;
if (format === "monthYear") {
	postDate = dateObj.toLocaleDateString("en-US", { year: "numeric", month: "long" });
} else {
	postDate = getFormattedDate(dateObj, dateTimeOptions);
}

const ISO = dateObj.toISOString();
---

<time datetime={ISO} title={ISO} {...attrs}>{postDate}</time>
